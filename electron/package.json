{
  "name": "sodaudio",
  "productName": "Sodaudio",
  "version": "0.1.2",
  "description": "Direct a game's audio with local AI models.",
  "author": "Soda Poppensky",
  "license": "MIT",
  "private": true,
  "main": "out/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "start": "npm run build:ts && electron .",
    "bundle-engine": "node scripts/bundle-engine.mjs",
    "dist": "npm run build:ts && node scripts/bundle-engine.mjs && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build:ts && node scripts/bundle-engine.mjs && electron-builder --win dir --publish never",
    "release": "npm run build:ts && node scripts/bundle-engine.mjs && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.sodapoppensky.sodaudio",
    "productName": "Sodaudio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sodaudio",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thebrotherscarr-bit",
        "repo": "Sodaudio",
        "releaseType": "release"
      }
    ]
  },
  "repository": "github:thebrotherscarr-bit/Sodaudio"
}
